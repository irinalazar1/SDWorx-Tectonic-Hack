# Copy to .env and fill in. Never commit .env.

# Password for all demo accounts (choose your own).
DEMO_PASSWORD=

# Long random string used to sign session tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Detection engine: "rules" (offline, default) or "gemini" (Vertex AI).
DETECTION_ENGINE=rules

# Only needed for DETECTION_ENGINE=gemini. Authenticate with:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash
