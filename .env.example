# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Password for all demo accounts, at least 10 characters.
DEMO_PASSWORD=

# Signs session tokens and CSRF tokens. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Lists the demo accounts on the sign-in screen. Keep false anywhere but a demo.
DEMO_MODE=true

# Session cookies are Secure by default. Chrome and Firefox accept Secure cookies on
# http://localhost; set this to false only if your browser (e.g. Safari) or host needs plain http.
COOKIE_SECURE=true

# Session length in seconds (default 8 hours).
SESSION_TTL_SECONDS=28800

# Requests allowed per client address per minute on /api.
RATE_LIMIT_REQUESTS=300

# Detection engine: "rules" (offline, default) or "gemini" (Vertex AI).
DETECTION_ENGINE=rules

# Only needed for DETECTION_ENGINE=gemini. Authenticate with:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash
